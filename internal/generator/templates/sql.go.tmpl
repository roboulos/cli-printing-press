// newSQLCmd exposes the local store's composition escape hatch. Named
// workflows remain the preferred interface; sql exists for joins and
// aggregations that are only possible once several resources are synced.
func newSQLCmd(flags *rootFlags) *cobra.Command {
	var dbPath string

	cmd := &cobra.Command{
		Use:         "sql [query...]",
		Short:       "Run read-only SQL against the local store",
		Long:        "Execute a SELECT or WITH...SELECT query against the local SQLite store populated by sync. Results use the standard output pipeline, including --json, --compact, --select, --csv, and --quiet.",
		Annotations: map[string]string{"mcp:read-only": "true"},
		Args:        cobra.MinimumNArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			if dryRunOK(flags) {
				return nil
			}

			query := strings.TrimSpace(strings.Join(args, " "))
			if err := validateCLIReadOnlyQuery(query); err != nil {
				return usageErr(err)
			}

			if dbPath == "" {
				dbPath = defaultDBPath("{{.Name}}-pp-cli")
			}
			db, err := store.OpenReadOnly(dbPath)
			if err != nil {
				return configErr(fmt.Errorf("opening local database: %w\nRun '{{.Name}}-pp-cli sync' first to populate it", err))
			}
			defer db.Close()

			rows, err := db.Query(query)
			if err != nil {
				return apiErr(fmt.Errorf("query failed: %w", err))
			}
			defer rows.Close()

			columns, err := rows.Columns()
			if err != nil {
				return apiErr(fmt.Errorf("reading query columns: %w", err))
			}
			results := make([]map[string]any, 0)
			for rows.Next() {
				values := make([]any, len(columns))
				pointers := make([]any, len(columns))
				for i := range values {
					pointers[i] = &values[i]
				}
				if err := rows.Scan(pointers...); err != nil {
					return apiErr(fmt.Errorf("scanning query row: %w", err))
				}
				row := make(map[string]any, len(columns))
				for i, column := range columns {
					row[column] = normalizeCLISQLValue(values[i])
				}
				results = append(results, row)
			}
			if err := rows.Err(); err != nil {
				return apiErr(fmt.Errorf("iterating query rows: %w", err))
			}

			return printJSONFiltered(cmd.OutOrStdout(), results, flags)
		},
	}
	cmd.Flags().StringVar(&dbPath, "db", "", "Database path")
